# NER-LENS Environment Variables (SIH26001 - MDoNER)
# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production

# Weather Ingestion Providers
# Default provider uses Open-Meteo real-time global AWS gridded telemetry (no key required)
WEATHER_PROVIDER=OPEN_METEO
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Official IMD API Adapter (Optional: Provide if official API keys are provisioned)
IMD_API_KEY=
IMD_API_BASE_URL=https://mausam.imd.gov.in/api

# NDMA SACHET / CAP v1.2 Gateway
SACHET_BASE_URL=https://sachet.ndma.gov.in/cap_feed
CAP_POLL_INTERVAL_SECONDS=120

# Database Configuration
DATABASE_URL=sqlite:///./ner_lens.db

# Storage Configuration
UPLOAD_DIR=./uploads
